<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs `dossier ingest` on each store every 15 minutes.
  Copy to ~/Library/LaunchAgents/, replace YOU and the store list, then:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dossier-ingest.plist
  Stop with:
    launchctl bootout gui/$(id -u)/dossier-ingest
  PATH must reach dossier, the ACP server (node), herdr and every connector's tools.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dossier-ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>L="$HOME/Library/Logs/dossier-ingest.log"; [ "$(stat -f%z "$L" 2&gt;/dev/null || echo 0)" -gt 1048576 ] &amp;&amp; mv "$L" "$L.1"; for s in "$HOME/dossiers/perso" "$HOME/dossiers/pro"; do echo "--- $(date '+%Y-%m-%d %H:%M:%S') $s"; dossier ingest --store "$s" --format text; done</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOU/go/bin:/opt/homebrew/bin:/Users/YOU/.local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/dossier-ingest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/dossier-ingest.log</string>
</dict>
</plist>
